<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Umwami.uss" />
    <ui:VisualElement name="root" class="screen slate">
        <ui:VisualElement name="title" class="page center frame" style="padding-top: 40px; padding-bottom: 22px;">
            <ui:VisualElement class="center">
                <ui:VisualElement class="row">
                    <ui:VisualElement class="rule" />
                    <ui:VisualElement class="diamond" />
                    <ui:VisualElement class="rule" />
                </ui:VisualElement>
                <ui:Label text="Umwami's Ascend" class="display h1" style="margin-top: 10px;" />
                <ui:Label text="Legend of the First King" class="serif tagline" />
            </ui:VisualElement>
            <ui:VisualElement class="row">
                <ui:Button name="begin" text="Begin" class="btn btn-primary"><ui:VisualElement class="btn-inner" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="chapters" text="Chapters" class="btn"><ui:VisualElement class="btn-inner" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="about" text="About" class="btn"><ui:VisualElement class="btn-inner" picking-mode="Ignore" /></ui:Button>
            </ui:VisualElement>
            <ui:Label text="You need a table or a clear patch of floor, and some light." class="small" />
        </ui:VisualElement>

        <ui:VisualElement name="chapters-overlay" class="page hidden" style="padding: 0;">
            <ui:VisualElement name="chapters-dim" class="dim" />
            <ui:VisualElement class="side">
                <ui:VisualElement class="row between" style="margin-bottom: 6px;">
                    <ui:Label text="Chapters" class="display h3" />
                    <ui:Button name="chapters-close" class="icon-btn" />
                </ui:VisualElement>
                <ui:VisualElement name="chapter-list" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="about-overlay" class="page center dim-strong hidden" style="padding: 22px 40px;">
            <ui:Label text="About this telling" class="display h2" />
            <ui:Label name="about-text" class="body" />
            <ui:Button name="about-close" text="Back" class="btn"><ui:VisualElement class="btn-inner" picking-mode="Ignore" /></ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
