.screen {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    -unity-font-definition: url("project://database/Assets/MobileARTemplateAssets/UI/Fonts/Lato-Regular.ttf");
    color: #F3EBDD; font-size: 15px;
}
.screen Label { margin: 0; padding: 0; white-space: normal; }
.page { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 16px 20px; justify-content: space-between; }
.row { flex-direction: row; align-items: center; }
.between { justify-content: space-between; }
.top { align-items: flex-start; }
.center { align-items: center; }
.grow { flex-grow: 1; }

.slate { background-color: #22252D; }
.frame { border-width: 1px; border-color: #D4B06B; }
.dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(34, 37, 45, 0.65); }
.dim-strong { background-color: rgba(34, 37, 45, 0.92); }

.display { -unity-font-definition: url("project://database/Assets/MobileARTemplateAssets/UI/Fonts/MarcellusSC-Regular.ttf"); color: #D4B06B; letter-spacing: 3px; -unity-text-align: middle-center; }
.serif { -unity-font-definition: url("project://database/Assets/MobileARTemplateAssets/UI/Fonts/Marcellus-Regular.ttf"); }
.h1 { font-size: 46px; }
.h2 { font-size: 24px; }
.h3 { font-size: 20px; }
.tagline { font-size: 18px; letter-spacing: 1px; -unity-text-align: middle-center; margin-top: 4px; }
.small { font-size: 13px; color: #CFC5B2; -unity-text-align: middle-center; }
.body { font-size: 14px; -unity-text-align: middle-center; max-width: 640px; }
.diamond { width: 12px; height: 12px; border-width: 1px; border-color: #D4B06B; background-color: #D4B06B; rotate: 45deg; margin: 0 14px; }
.rule { width: 90px; height: 1px; background-color: #D4B06B; }

.btn {
    height: 44px; min-width: 120px; margin: 0 7px; padding: 0 22px;
    border-radius: 3px; border-width: 1px; border-color: #D4B06B;
    background-color: #3A2D26; color: #F3EBDD; font-size: 15px;
    -unity-font-definition: url("project://database/Assets/MobileARTemplateAssets/UI/Fonts/Lato-Bold.ttf");
}
.btn:hover { background-color: #4A3A30; }
.btn:active { background-color: #2A201A; }
.btn-primary { background-color: #F1DDB0; color: #2A2118; min-width: 180px; }
.btn-primary:hover { background-color: #F7E8C6; }
.btn-primary:active { background-color: #D9C290; }
.btn-inner { position: absolute; left: 3px; top: 3px; right: 3px; bottom: 3px; border-width: 1px; border-color: rgba(212, 176, 107, 0.6); }

.icon-btn {
    width: 44px; height: 44px; min-width: 44px; margin: 0 5px; padding: 0;
    border-radius: 22px; border-width: 2px; border-color: #D4B06B;
    background-color: #33261E; color: #F0D9A6; font-size: 14px;
    align-items: center; justify-content: center;
    -unity-font-definition: url("project://database/Assets/MobileARTemplateAssets/UI/Fonts/Lato-Bold.ttf");
}
.icon-btn:hover { background-color: #45342A; }
.icon-btn:active { background-color: #241A14; }
.icon-btn-off { opacity: 0.5; }

.parch { background-color: #F1DDB0; color: #2A2118; border-width: 1px; border-color: #D4B06B; border-radius: 4px; padding: 9px 16px; }
.parch-kicker { font-size: 12px; letter-spacing: 2px; color: #6B4A12; }
.parch-title { font-size: 22px; color: #2A2118; }
.parch-head { font-size: 20px; color: #6B4A12; -unity-text-align: middle-center; }
.parch-text { font-size: 15px; color: #2A2118; }
.dark-panel { background-color: rgba(34, 37, 45, 0.92); border-width: 1px; border-color: #D4B06B; border-radius: 4px; padding: 8px 10px; }

.subtitle { align-self: center; max-width: 560px; margin-bottom: 10px; padding: 7px 18px; font-size: 17px; -unity-text-align: middle-center;
    background-color: #F1DDB0; color: #2A2118; border-width: 1px; border-color: #D4B06B; border-radius: 4px; }
.bar { flex-grow: 1; height: 8px; margin: 0 12px; background-color: #15171C; border-width: 1px; border-color: rgba(212, 176, 107, 0.6); border-radius: 5px; }
.bar-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: #D4B06B; border-radius: 5px; }
.bar-tick { position: absolute; top: -4px; width: 2px; height: 14px; background-color: #F0D9A6; }
.time { font-size: 13px; min-width: 80px; -unity-text-align: middle-right; margin-right: 8px; }

.side { position: absolute; top: 0; right: 0; bottom: 0; width: 340px; padding: 14px 16px; background-color: rgba(34, 37, 45, 0.97); border-left-width: 1px; border-left-color: #D4B06B; }
.chap-row { flex-direction: row; align-items: center; height: 44px; margin: 0; padding: 0 12px; border-radius: 8px; border-width: 1px; border-color: rgba(0, 0, 0, 0); background-color: rgba(0, 0, 0, 0); color: #F3EBDD; }
.chap-row:hover { background-color: rgba(212, 176, 107, 0.10); }
.chap-row-current { border-color: #D4B06B; background-color: rgba(212, 176, 107, 0.16); }
.chap-num { font-size: 13px; color: #D4B06B; min-width: 24px; }
.chap-name { font-size: 17px; flex-grow: 1; }
.chap-status { font-size: 12px; color: #CFC5B2; }
.modal { max-width: 440px; padding: 18px 26px; align-items: center; }
.hidden { display: none; }
